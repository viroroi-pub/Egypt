# %% [markdown]
# # Monte Carlo Simulation for Edge-Ramp Logistics
# Simulates stochastic throughput for the 16→8→4→2→1 sequence (10 000×5 = 50 000 rows)
# Generates edge_ramp_montecarlo_10000x5.csv
# Author: V. L. Rosell Roig (2025)

# %%
import numpy as np
import pandas as pd

# Random seed for reproducibility
np.random.seed(42)

# %% [markdown]
# ## 1. Define baseline parameters
# From manuscript (Sections 4–5)
# Headway ≈ 4 min baseline; speed = 0.15 m/s; stochastic ±25 % speed and ±1 min headway.
# Corner delay is lognormal(median = 2.8 min, σ = 0.35).
# Each phase has its own number of active ramps and base load.

# %%
phases = {
    "Phase 1 (16 Ramps)": {"ramps": 16, "blocks": 317000},
    "Phase 2 (8 Ramps)":  {"ramps": 8,  "blocks": 315000},
    "Phase 3a (4 Ramps)": {"ramps": 4,  "blocks": 1677000},
    "Phase 3b (2 Ramps)": {"ramps": 2,  "blocks": 3300},
    "Phase 3c (1 Ramp)":  {"ramps": 1,  "blocks": 170},
}

N = 10_000  # Monte Carlo trials per phase
mu_corner, sigma_corner = 2.8, 0.35  # lognormal corner delay parameters

records = []

# %% [markdown]
# ## 2. Monte Carlo loop
# For each phase:
# - Sample speed ∼ Uniform(0.75 – 1.25)
# - Headway ∼ Normal(4 ± 1 min)
# - Corner delay ∼ LogNormal(μ = ln(median), σ = 0.35)
# - Compute ramp capacity (blocks / hour), queue length, waiting prob., blocking prob.
# Simple queueing model (M/M/1 approximation).

# %%
for phase, cfg in phases.items():
    speed_factor = np.random.uniform(0.75, 1.25, N)
    headway = np.clip(np.random.normal(4, 1, N), 1.5, 8.0)
    corner_delay = np.random.lognormal(np.log(mu_corner), sigma_corner, N)

    # Service rate per ramp (blocks/min)
    service_rate = 1 / headway

    # Arrival rate λ with ±10 % stochasticity around service_rate × utilization (0.9 – 1.1)
    utilization = np.random.uniform(0.85, 0.98, N)
    arrival_rate = utilization * service_rate

    # Queue length L = ρ²/(1−ρ)
    L = (utilization ** 2) / (1 - utilization)
    Wq = L / (arrival_rate + 1e-9)  # waiting time (min)
    P_wait = utilization
    P_block = np.clip(utilization ** 2, 0, 1)

    records.append(pd.DataFrame({
        "Phase": phase,
        "Trial": np.arange(1, N + 1),
        "SpeedFactor": speed_factor,
        "Headway_min": headway,
        "CornerDelay_min": corner_delay,
        "RampCapacity_blocks_per_hr": 60 / headway * cfg["ramps"],
        "Utilization": utilization,
        "MeanQueueLength": L,
        "MeanWaitingTime_min": Wq,
        "WaitingProb": P_wait,
        "BlockingProb": P_block,
    }))

df = pd.concat(records, ignore_index=True)

# %% [markdown]
# ## 3. Aggregate statistics (median + 95 % CI)
# %%
summary = (
    df.groupby("Phase")[["RampCapacity_blocks_per_hr", "MeanQueueLength",
                         "WaitingProb", "BlockingProb"]]
      .agg(["median", lambda x: np.percentile(x, 2.5),
                     lambda x: np.percentile(x, 97.5)])
)
summary.columns = ["_".join(col).strip() for col in summary.columns.values]
summary.reset_index(inplace=True)
summary

# %% [markdown]
# ## 4. Export to CSV
# %%
df.to_csv("edge_ramp_montecarlo_10000x5.csv", index=False)
summary.to_csv("edge_ramp_montecarlo_summary.csv", index=False)

print("✅ Monte Carlo dataset saved as 'edge_ramp_montecarlo_10000x5.csv'")
print("   and summary statistics in 'edge_ramp_montecarlo_summary.csv'")

# %% [markdown]
# ## 5. Boxplot example 
# %%
import matplotlib.pyplot as plt

fig, ax = plt.subplots(figsize=(8, 5))
df.boxplot(column="RampCapacity_blocks_per_hr", by="Phase", ax=ax,
           grid=False, patch_artist=True, boxprops=dict(facecolor="lightgray"))
ax.set_ylabel("Ramp capacity (blocks per hour)")
ax.set_xlabel("Construction phase")
ax.set_title("Median ramp capacity per phase (10 000 trials)")
plt.suptitle("")
plt.tight_layout()
plt.savefig("median_capacity_per_phase_boxplot.png", dpi=300)
plt.show()
